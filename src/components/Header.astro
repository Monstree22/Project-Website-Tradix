---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Tradix Community, ke beranda">
      <img src="/images/brand/logo-256.png" alt="" width="40" height="40" />
      <span>Tradix<b>Community</b></span>
    </a>

    <nav class="desk-nav" aria-label="Navigasi utama">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-menu" data-dropdown>
                <button
                  class:list={['nav-link', { active: isActive(item.href) }]}
                  aria-expanded="false"
                  aria-controls="menu-tentang"
                  data-dropdown-btn
                >
                  {item.label}
                  <Icon name="chevron" />
                </button>
                <div class="dropdown" id="menu-tentang">
                  <a class="dropdown-all" href={item.href}>
                    Semua tentang Tradix <Icon name="arrow" />
                  </a>
                  {item.children.map((c) => (
                    <a class="dropdown-item" href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                      <strong>{c.label}</strong>
                      <span>{c.desc}</span>
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li>
                <a
                  class:list={['nav-link', { active: isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="bar-actions">
      <a class="btn btn--primary btn--sm join" href={site.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Gabung gratis
      </a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
        <span class="visually-hidden" data-menu-label>Buka menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav class="wrap" aria-label="Navigasi seluler">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="m-link">
                {item.label}
              </a>
              {item.children && (
                <ul class="m-sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="m-actions">
        <a class="btn btn--primary" href={site.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Gabung WhatsApp Community
        </a>
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" /> Ikuti Instagram
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled,
  .site-header.open {
    background: rgb(7 11 20 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    min-height: 44px;
  }
  .brand img {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
  }
  .brand b {
    font-weight: 500;
    color: var(--muted);
    margin-left: 6px;
  }
  .desk-nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    border: 0;
    background: none;
    color: var(--ink-2);
    font: 500 0.96rem/1 var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
    background: var(--surface-2);
  }
  .nav-link :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.2s var(--ease);
  }
  .has-menu {
    position: relative;
  }
  .has-menu[data-open] .nav-link :global(svg) {
    transform: rotate(180deg);
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: -12px;
    width: 340px;
    padding: 10px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
    display: grid;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0s 0.18s;
  }
  .has-menu[data-open] .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .dropdown-item,
  .dropdown-all {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .dropdown-item:hover,
  .dropdown-all:hover,
  .dropdown-item[aria-current='page'] {
    background: var(--surface-2);
  }
  .dropdown-item strong {
    font-weight: 600;
  }
  .dropdown-item span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .dropdown-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--accent-2);
    font-weight: 600;
    border-bottom: 1px solid var(--line);
    border-radius: 12px 12px 0 0;
    margin-bottom: 4px;
  }
  .dropdown-all :global(svg) {
    width: 16px;
    height: 16px;
  }
  .bar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn--sm {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.92rem;
  }
  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .menu-btn :global(svg) {
    width: 22px;
    height: 22px;
    grid-area: 1/1;
  }
  .menu-btn :global(.i-close),
  .open .menu-btn :global(.i-open) {
    display: none;
  }
  .open .menu-btn :global(.i-close) {
    display: block;
  }

  .mobile-menu {
    background: var(--bg);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: 16px 32px;
    border-top: 1px solid var(--line);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-link {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .m-sub {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 16px;
    padding: 8px 0 14px !important;
    border-bottom: 1px solid var(--line);
  }
  .m-sub a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .m-actions {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 980px) {
    .desk-nav {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .join {
      display: none;
    }
    .brand b {
      display: none;
    }
  }
  @media (min-width: 981px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Dropdown "Tentang": buka dengan klik/keyboard, hover di desktop.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-dropdown-btn]')!;
    const set = (open: boolean) => {
      li.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => set(!li.hasAttribute('data-open')));
    li.addEventListener('mouseenter', () => matchMedia('(hover:hover)').matches && set(true));
    li.addEventListener('mouseleave', () => matchMedia('(hover:hover)').matches && set(false));
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) set(false);
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        set(false);
        btn.focus();
      }
    });
  });

  // Menu seluler layar penuh.
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const label = document.querySelector<HTMLElement>('[data-menu-label]')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Tutup menu' : 'Buka menu';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setMenu(false);
      menuBtn.focus();
    }
  });
  matchMedia('(min-width: 981px)').addEventListener('change', (e) => e.matches && setMenu(false));
</script>
