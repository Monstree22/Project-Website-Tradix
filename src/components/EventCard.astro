---
import Icon from './Icon.astro';
import { formatDate, posterHeight, type TradixEvent } from '../data/events';
interface Props {
  event: TradixEvent;
  compact?: boolean;
  featured?: boolean;
}
const { event, compact = false, featured = false } = Astro.props;
---

<article class:list={['event card', { featured }]} id={event.slug}>
  <div class="frame poster">
    <img
      src={event.poster}
      alt={`Poster ${event.type}: ${event.title}`}
      width="900"
      height={posterHeight[event.posterRatio]}
      loading="lazy"
    />
  </div>
  <div class="body">
    <div class="chips">
      <span class="badge badge--neutral">{event.type}{event.city ? ` · ${event.city}` : ''}</span>
      {event.recurring && <span class="badge badge--up">Rutin</span>}
    </div>
    <h3>{event.title}</h3>
    <ul class="facts">
      {
        event.recurring && (
          <li>
            <Icon name="calendar" />
            {event.recurring}
            {event.time ? `, ${event.time}` : ''}
          </li>
        )
      }
      {
        event.date && (
          <li>
            <Icon name="calendar" />
            {formatDate(event.date)}
            {event.time ? `, ${event.time}` : ''}
          </li>
        )
      }
      <li><Icon name="pin" />{event.place}</li>
    </ul>
    {
      event.registerUrl && (
        <a class="btn btn--primary register" href={event.registerUrl} target="_blank" rel="noopener">
          Daftar sekarang <Icon name="arrow" />
        </a>
      )
    }
    {
      !compact && event.speakers.length > 0 && (
        <div class="speakers">
          <h4>Pembicara</h4>
          <ul>
            {event.speakers.map((s) => (
              <li>
                <strong>{s.name}</strong> <span>{s.role}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>

<style>
  .event {
    padding: 12px;
    gap: 0;
  }
  .poster {
    aspect-ratio: 4 / 5;
    background: #0a1222;
  }
  /* poster ditampilkan utuh, tidak terpotong */
  .poster img {
    object-fit: contain;
  }
  .body {
    display: grid;
    gap: 12px;
    padding: 18px 10px 10px;
    align-content: start;
  }
  .body h3 {
    font-size: 1.15rem;
  }
  .featured {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
  }
  .featured .body {
    padding: 12px 12px 12px 0;
    gap: 16px;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .featured .facts {
    font-size: 1rem;
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .featured .body {
      padding: 18px 10px 10px;
    }
  }
  .register {
    justify-self: start;
    margin-top: 4px;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    font-size: 0.93rem;
  }
  .facts li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .facts :global(svg) {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    color: var(--muted);
    flex: none;
  }
  .speakers {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .speakers h4 {
    font: 500 0.72rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .speakers ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 4px;
    font-size: 0.92rem;
  }
  .speakers span {
    color: var(--muted);
  }
</style>
