---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MarketTicker from '../components/MarketTicker.astro';
import TerminalHero from '../components/TerminalHero.astro';
import PersonCard from '../components/PersonCard.astro';
import EventCard from '../components/EventCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import { site, stats } from '../data/site';
import { roadmap } from '../data/materi';
import { team } from '../data/team';
import { upcomingEvents, pastEvents } from '../data/events';
import { faqGroups } from '../data/faq';

// Event mendatang dulu, lalu diisi event terbaru sampai 3 kartu.
const latest = [...upcomingEvents, ...pastEvents.filter((e) => e.date)].slice(0, 3);
const faqTeaser = faqGroups.flatMap((g) => g.items).slice(0, 4);

const benefits = [
  { icon: 'chart', title: 'Update market harian', text: 'Kondisi BTC, altcoin, gold dan forex dirangkum setiap hari di grup.' },
  { icon: 'mic', title: 'Webinar rutin', text: 'Belajar langsung dari trader aktif dan tamu dari komunitas partner.' },
  { icon: 'candles', title: 'Bedah chart bareng', text: 'Kirim setup kamu, dibahas bersama member dan analis Tradix.' },
  { icon: 'users', title: 'Meetup offline', text: 'Ketemu trader lain di Bogor, Bekasi dan kota berikutnya.' },
  { icon: 'shield', title: 'Risiko dulu, profit belakangan', text: 'Position sizing dan stop loss diajarkan sebelum strategi entry.' },
  { icon: 'gift', title: 'Giveaway member aktif', text: 'Merchandise dan USDT untuk peserta event dan member yang aktif.' },
] as const;
---

<Base>
  <section class="hero">
    <TerminalHero />
    <div class="wrap hero-grid">
      <div class="hero-copy" data-enter>
        <span class="eyebrow">Official Partner BingX · Gratis</span>
        <h1>Belajar trading crypto & forex dari nol, bareng {stats[0].value} trader Indonesia</h1>
        <p class="lead">
          Tradix adalah komunitas edukasi, bukan grup sinyal. Roadmap 8 minggu, webinar, bedah chart dan meetup offline,
          semuanya tanpa biaya.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Gabung WhatsApp gratis
          </a>
          <a class="btn btn--ghost" href="/materi/">Lihat roadmap belajar</a>
        </div>
        <dl class="hero-stats">
          {
            stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd class="mono" data-count>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

    </div>
  </section>

  <MarketTicker />

  <section class="section" id="kenapa">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Kenapa Tradix</span>
        <h2>Lingkungan belajar trading yang aktif setiap hari</h2>
        <p class="lead">Semua yang dibutuhkan pemula untuk mulai serius, tanpa janji cepat kaya.</p>
      </div>
      <div class="grid grid-3">
        {
          benefits.map((b) => (
            <article class="card">
              <span class="icon-tile">
                <Icon name={b.icon} />
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper" id="roadmap">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="section-head" style="margin:0">
          <span class="eyebrow">Materi</span>
          <h2>Roadmap belajar 8 minggu</h2>
          <p class="lead">Tersusun bertahap: dari istilah dasar sampai punya trading plan sendiri.</p>
        </div>
        <a class="link-arrow" href="/materi/">Lihat silabus lengkap <Icon name="arrow" /></a>
      </div>
      <div class="road" data-progress data-progress-mode="index">
      <div class="track" aria-hidden="true">
        <div class="track-bar">
          <span class="track-fill"></span>
          {roadmap.map((w) => <span class="tick" style={`--i:${w.week - 1}`}></span>)}
        </div>
        <span class="track-label mono" data-progress-label>Mulai dari Minggu 1</span>
      </div>
      <ol class="weeks">
        {
          roadmap.map((w) => (
            <li data-step>
              <a class="card week" href={`/materi/minggu-${w.week}/`}>
                <span class="wk mono">Minggu {String(w.week).padStart(2, '0')}</span>
                <h3>{w.title}</h3>
                <p>{w.summary}</p>
              </a>
            </li>
          ))
        }
      </ol>
      </div>
    </div>
  </section>

  <section class="section" id="tim">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="section-head" style="margin:0">
          <span class="eyebrow">Tentang</span>
          <h2>Orang di balik Tradix</h2>
          <p class="lead">Founder dan tim eksekutif yang mengisi kelas, webinar dan meetup.</p>
        </div>
        <a class="link-arrow" href="/tentang/">Kenali komunitasnya <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-4">
        {
          team.map((p) => (
            <PersonCard person={p} href={p.group === 'founder' ? '/tentang/founder/' : '/tentang/eksekutif/'} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" id="event">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="section-head" style="margin:0">
          <span class="eyebrow">Event</span>
          <h2>{upcomingEvents.length ? 'Event mendatang & terbaru' : 'Event terbaru Tradix'}</h2>
          <p class="lead">Webinar online dan meetup offline bersama partner komunitas.</p>
        </div>
        <a class="link-arrow" href="/event/">Semua event <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-3">
        {latest.map((e) => <EventCard event={e} compact />)}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-split">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Pertanyaan sebelum gabung</h2>
        <p class="lead">Jawaban singkat untuk yang paling sering ditanya calon member.</p>
        <a class="link-arrow" href="/faq/">Semua pertanyaan <Icon name="arrow" /></a>
      </div>
      <FaqList items={faqTeaser} />
    </div>
  </section>

  <CtaBand />
  <ScrollProgress />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 56px;
    background:
      radial-gradient(50% 60% at 78% 40%, rgb(47 123 255 / 0.22), transparent 70%),
      radial-gradient(40% 40% at 10% 100%, rgb(31 199 126 / 0.08), transparent 70%),
      var(--bg);
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 680px);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .hero-copy h1 {
    font-size: clamp(2.5rem, 5.2vw, 4.4rem);
    max-width: 15ch;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 12px 32px;
    margin: 12px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero-stats dd {
    margin: 0;
    font-size: 1.6rem;
    color: var(--ink);
  }
  .hero-stats dt {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .weeks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .week {
    height: 100%;
    gap: 10px;
    transition:
      transform 0.2s var(--ease),
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .reached .week {
    border-color: var(--accent);
    box-shadow:
      0 0 0 1px var(--accent),
      0 18px 40px -24px rgb(47 123 255 / 0.55);
  }
  .wk {
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .reached .wk {
    justify-self: start;
    color: #fff;
    background: var(--accent);
    padding: 3px 8px;
    border-radius: 6px;
    margin: -3px 0 -3px -8px;
  }

  /* bar progres yang menempel di atas saat kartu di-scroll */
  .track {
    position: sticky;
    top: calc(var(--header-h) + 10px);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding: 12px 16px;
    border-radius: var(--r-pill);
    background: rgb(243 245 249 / 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--paper-line);
    box-shadow: 0 10px 24px -14px rgb(11 18 32 / 0.35);
  }
  .track-bar {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--paper-line);
  }
  .track-fill {
    position: absolute;
    inset: 0 auto 0 0;
    /* minggu ke-k menyala tepat saat isian mencapai titik ke-k */
    width: calc(min(1, var(--p, 0) * 8 / 7) * 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), #1fc77e);
    box-shadow: 0 0 12px rgb(47 123 255 / 0.5);
  }
  .tick {
    position: absolute;
    top: 50%;
    left: calc(var(--i) / 7 * 100%);
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--paper-line);
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }
  .road[data-reached='1'] .tick:nth-of-type(-n + 2),
  .road[data-reached='2'] .tick:nth-of-type(-n + 3),
  .road[data-reached='3'] .tick:nth-of-type(-n + 4),
  .road[data-reached='4'] .tick:nth-of-type(-n + 5),
  .road[data-reached='5'] .tick:nth-of-type(-n + 6),
  .road[data-reached='6'] .tick:nth-of-type(-n + 7),
  .road[data-reached='7'] .tick:nth-of-type(-n + 8),
  .road[data-reached='8'] .tick {
    background: var(--accent);
    border-color: var(--accent);
  }
  .track-label {
    min-width: 13ch;
    text-align: right;
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
  }
  .week h3 {
    color: var(--paper-ink);
  }
  .wk {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .faq-split {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .faq-split .section-head {
    justify-items: start;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .weeks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .faq-split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, auto);
    }
    .weeks {
      grid-template-columns: 1fr;
    }
  }
</style>
