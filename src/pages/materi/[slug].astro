---
// Halaman modul per minggu: /materi/minggu-N/
// Desktop (layar lebar & cukup tinggi): buku 3D. Sampul terbuka otomatis saat halaman dimuat,
//   lalu setiap scroll membalik satu halaman (kiri: diagram + catatan, kanan: materi).
// HP / layar kecil / "kurangi animasi": halaman tersusun ke bawah dan tiap halaman
//   "membuka" seperti kertas saat masuk layar.
// Animasi memakai library Motion (penerus Framer Motion, versi tanpa React).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import LeftPage from '../../components/BookLeftPage.astro';
import { getModules, type Modul } from '../../lib/modul';

export async function getStaticPaths() {
  const mods = await getModules();
  return mods.map((m, i) => ({
    params: { slug: m.slug },
    props: { mod: m, prev: mods[i - 1] ?? null, next: mods[i + 1] ?? null, total: mods.length },
  }));
}

interface Props {
  mod: Modul;
  prev: Modul | null;
  next: Modul | null;
  total: number;
}
const { mod, prev, next, total } = Astro.props;
const N = mod.pages.length;
const wk = String(mod.week).padStart(2, '0');
---

<Base title={`Minggu ${mod.week}: ${mod.title}`} description={`Modul belajar Tradix minggu ${mod.week}: ${mod.subtitle}.`}>
  <script is:inline>
    // Pasang mode sebelum halaman tergambar, supaya tata letak tidak melompat.
    (function () {
      var d = document.documentElement;
      d.classList.add('js-book');
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && matchMedia('(min-width: 1100px) and (min-height: 700px)').matches) d.classList.add('book-mode');
    })();
  </script>

  <section class="mod-hero">
    <div class="wrap" data-enter>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/materi/">Materi</a><span aria-hidden="true">/</span
        ><a href={`/materi/${mod.slug}/`}>Minggu {mod.week}</a>
      </nav>
      <span class="eyebrow">Modul minggu {wk} dari {total}</span>
      <h1>{mod.title}</h1>
      <p class="lead">{mod.subtitle}.</p>
      <ul class="meta">
        <li><Icon name="clock" /> {mod.duration}</li>
        <li><Icon name="book" /> {N} halaman</li>
        <li class="only-book"><Icon name="arrow" /> Scroll untuk membalik halaman</li>
      </ul>
    </div>
  </section>

  <section class="stage" data-stage style={`--n:${N}`} aria-label={`Isi modul minggu ${mod.week}`}>
    <div class="sticky">
      <div class="book" data-book>
        {/* daun 0: sampul + halaman kiri pertama */}
        <div class="leaf" data-leaf="0">
          <div class="face front cover">
            <div class="cover-top">
              <img src="/images/brand/logo-256.png" alt="" width="44" height="44" />
              <span>Tradix Community · Modul belajar</span>
            </div>
            <div class="cover-main">
              <span class="cover-num">{wk}</span>
              <h2 class="cover-title">{mod.title}</h2>
              <p>{mod.subtitle}</p>
            </div>
            <div class="cover-foot">
              <span>Roadmap 8 minggu</span>
              <span>{mod.duration} · {N} halaman</span>
            </div>
          </div>
          <LeftPage page={mod.pages[0]} index={0} />
        </div>

        {
          mod.pages.map((pg, i) => (
            <div class="leaf" data-leaf={i + 1}>
              <article class="face front text-page">
                <header class="page-top">
                  <span>Minggu {wk} · {mod.title}</span>
                  <span>
                    {i + 1}/{N}
                  </span>
                </header>
                <h2>{pg.heading}</h2>
                <div class="prose-book" set:html={pg.html} />
              </article>
              {i + 1 < N ? <LeftPage page={mod.pages[i + 1]} index={i + 1} /> : <div class="face back end-back" aria-hidden="true" />}
            </div>
          ))
        }
      </div>
      <div class="hud only-book" aria-hidden="true">
        <span class="hud-page mono" data-hud>Hal. 1 dari {N}</span>
        <span class="hud-bar"><i data-hud-bar></i></span>
        <span class="hud-hint">Scroll untuk membalik</span>
      </div>
    </div>
  </section>

  <section class="section section--tight mod-end">
    <div class="wrap">
      <div class="end-card">
        <div>
          <span class="eyebrow">Selesai membaca</span>
          <h2>Minggu {mod.week}: {mod.title}</h2>
          <p class="lead">Kerjakan latihannya, lalu bawa hasilnya ke grup untuk dibahas bareng mentor.</p>
        </div>
        <div class="btn-row">
          {
            next ? (
              <a class="btn btn--primary" href={`/materi/${next.slug}/`}>
                Lanjut ke Minggu {next.week}: {next.title} <Icon name="arrow" />
              </a>
            ) : (
              <a class="btn btn--primary" href="/materi/">
                Kembali ke roadmap <Icon name="arrow" />
              </a>
            )
          }
          {prev && (
            <a class="btn btn--ghost" href={`/materi/${prev.slug}/`}>
              Minggu {prev.week}: {prev.title}
            </a>
          )}
        </div>
      </div>
      <p class="disclaimer" style="margin-top:24px">
        <strong>Catatan:</strong> Modul ini adalah materi edukasi, bukan saran finansial. Latihan sebaiknya dilakukan di akun demo
        atau dengan modal yang siap hilang.
      </p>
    </div>
  </section>

  <CtaBand title="Belajar modul ini bareng member lain" text="Diskusikan latihan setiap minggu di WhatsApp Community dan sesi Market Outlook Tradix." />
</Base>

<script>
  import { animate, scroll, inView } from 'motion';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const book = document.querySelector<HTMLElement>('[data-book]');
  const root = document.documentElement;
  if (stage && book) {
    const leaves = [...book.querySelectorAll<HTMLElement>('[data-leaf]')];
    const N = leaves.length - 1; // jumlah halaman materi
    const hud = document.querySelector<HTMLElement>('[data-hud]');
    const hudBar = document.querySelector<HTMLElement>('[data-hud-bar]');

    if (root.classList.contains('book-mode')) {
      // ---------- mode buku (desktop) ----------
      const angles = leaves.map(() => 0);
      const setAngle = (k: number, a: number) => {
        angles[k] = a;
        const leaf = leaves[k];
        leaf.style.setProperty('--a', a.toFixed(2));
        leaf.style.setProperty('--shade', Math.sin((a * Math.PI) / 180).toFixed(3));
        leaf.style.zIndex = String(a > 0.5 && a < 179.5 ? N * 3 : a >= 90 ? N + k : N * 2 - k);
        leaf.querySelector('.back')?.classList.toggle('is-open', a > 110);
      };
      leaves.forEach((_, k) => setAngle(k, 0));
      const updateHud = () => {
        const opened = angles.slice(1).filter((a) => a >= 90).length;
        const page = Math.min(N, opened + 1);
        if (hud) hud.textContent = `Hal. ${page} dari ${N}`;
        if (hudBar) hudBar.style.width = `${(page / N) * 100}%`;
      };

      // 1) sampul terbuka otomatis
      book.style.setProperty('--shift', '-25%');
      animate(0, 1, {
        duration: 1.9,
        delay: 0.9,
        ease: [0.65, 0, 0.25, 1],
        onUpdate: (v) => {
          setAngle(0, v * 180);
          book.style.setProperty('--shift', `${-25 * (1 - v)}%`);
        },
        onComplete: updateHud,
      });

      // 2) scroll membalik halaman satu per satu (dengan jeda di setiap halaman)
      const dwell = (t: number) => {
        const x = Math.min(1, Math.max(0, (t - 0.2) / 0.6));
        return x * x * (3 - 2 * x);
      };
      scroll(
        (p: number) => {
          const f = p * (N - 1);
          for (let k = 1; k < N; k++) setAngle(k, dwell(f - (k - 1)) * 180);
          updateHud();
        },
        { target: stage, offset: ['start start', 'end end'] },
      );

      // ganti mode saat ukuran layar berubah melewati batas
      const mq = matchMedia('(min-width: 1100px) and (min-height: 700px)');
      mq.addEventListener('change', () => location.reload());
    } else {
      // ---------- mode baca (HP / layar kecil / kurangi animasi) ----------
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const faces = [...book.querySelectorAll<HTMLElement>('.face:not(.end-back)')];
      if (reduce) {
        faces.forEach((f) => f.classList.add('is-open'));
      } else {
        root.classList.add('flip-ready');
        faces.forEach((f) => {
          inView(
            f,
            () => {
              f.classList.add('is-open');
              animate(
                f,
                { opacity: [0, 1], transform: ['perspective(1000px) rotateY(-55deg)', 'perspective(1000px) rotateY(0deg)'] },
                { duration: 0.9, ease: [0.2, 0.8, 0.2, 1] },
              );
            },
            { amount: 0.2 },
          );
        });
      }
      const mq = matchMedia('(min-width: 1100px) and (min-height: 700px)');
      mq.addEventListener('change', () => !reduce && location.reload());
    }
  }
</script>

<style is:global>
  /* ---------- warna kertas & diagram ---------- */
  .stage {
    --paper: #f6f2e8;
    --paper-2: #efe9db;
    --ink-p: #1d2433;
    --muted-p: #5d6676;
    --d-up: #129e66;
    --d-down: #d9414c;
    --d-accent: #2563eb;
    --d-ink: #1d2433;
    --d-muted: #6b7280;
    --d-warn: #c27c0e;
    --d-grid: #e3dccb;
    --d-paper: #f6f2e8;
  }

  .mod-hero {
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 72px));
    padding-bottom: clamp(24px, 4vw, 40px);
    background:
      radial-gradient(60% 80% at 80% 0%, rgb(47 123 255 / 0.16), transparent 70%),
      var(--bg);
  }
  .mod-hero .wrap {
    display: grid;
    gap: 16px;
  }
  .mod-hero h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
  }
  .meta {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .meta svg {
    width: 18px;
    height: 18px;
    color: var(--accent-2);
  }
  .only-book {
    display: none !important;
  }
  .book-mode .only-book {
    display: flex !important;
  }
  .book-mode .meta li.only-book {
    display: inline-flex !important;
  }

  /* ---------- mode baca (default) ---------- */
  .stage {
    padding: 8px 0 24px;
  }
  .book {
    width: min(720px, calc(100% - var(--gutter) * 2));
    margin-inline: auto;
    display: grid;
    gap: 18px;
  }
  .leaf {
    display: contents;
  }
  .face {
    border-radius: 16px;
    padding: clamp(22px, 5vw, 36px);
    color: var(--ink-p);
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 24px 50px -30px rgb(0 0 0 / 0.8);
  }
  /* animasi "lipat kertas" di mode baca berputar dari tepi kiri */
  html:not(.book-mode) .face {
    transform-origin: left center;
  }
  .flip-ready .face {
    opacity: 0;
  }
  .face.back {
    background: var(--paper-2);
  }
  .end-back {
    display: none;
  }

  .cover {
    color: #e9eef8;
    background:
      radial-gradient(90% 70% at 85% 10%, rgb(47 123 255 / 0.45), transparent 60%),
      linear-gradient(160deg, #13244a, #0a1222 70%);
    border: 1px solid #22407a;
    display: grid;
    align-content: space-between;
    gap: 28px;
    min-height: 340px;
  }
  .cover-top {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 0.78rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a9b6cf;
  }
  .cover-top img {
    border-radius: 10px;
    border: 1px solid #2a3a56;
  }
  .cover-main {
    display: grid;
    gap: 8px;
  }
  .cover-num {
    font: 700 clamp(4rem, 9vw, 7rem) / 0.9 var(--font-display);
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #ffffff, #7fa9ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cover-title {
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    color: #fff;
  }
  .cover-main p {
    color: #c3ccdb;
    max-width: 30ch;
  }
  .cover-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font: 500 0.78rem/1.3 var(--font-mono);
    color: #a9b6cf;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .page-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 500 0.72rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-p);
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid #e2dccc;
  }
  .text-page h2 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    color: var(--ink-p);
    margin-bottom: 14px;
  }
  .prose-book {
    display: grid;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.62;
    color: #333b4b;
  }
  .prose-book p,
  .prose-book ul,
  .prose-book ol {
    margin: 0;
  }
  .prose-book ul,
  .prose-book ol {
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
  .prose-book strong {
    color: var(--ink-p);
  }
  .prose-book li::marker {
    color: var(--d-accent);
    font-weight: 700;
  }

  /* ---------- mode buku (desktop) ---------- */
  .book-mode .stage {
    height: calc(100vh + (var(--n) - 1) * 72vh);
    padding: 0;
  }
  .book-mode .sticky {
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    overflow: hidden;
  }
  .book-mode .book {
    position: relative;
    display: block;
    width: min(1160px, 94vw);
    height: min(680px, calc(100vh - var(--header-h) - 96px));
    margin: 0;
    perspective: 2600px;
    transform: translateX(var(--shift, 0%));
  }
  /* bayangan buku di "meja" */
  .book-mode .book::before {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -26px;
    height: 40px;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
    filter: blur(6px);
  }
  .book-mode .leaf {
    display: block;
    position: absolute;
    top: 0;
    left: 50%;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--a, 0) * -1deg));
  }
  .book-mode .face {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 4px 14px 14px 4px;
    padding: clamp(26px, 3vw, 42px) clamp(28px, 3.4vw, 48px);
    box-shadow:
      inset 18px 0 24px -18px rgb(0 0 0 / 0.28),
      0 30px 60px -30px rgb(0 0 0 / 0.75);
  }
  .book-mode .face.back {
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
    box-shadow:
      inset -18px 0 24px -18px rgb(0 0 0 / 0.28),
      0 30px 60px -30px rgb(0 0 0 / 0.75);
  }
  /* bayangan lengkung saat halaman berputar */
  .book-mode .face::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.35), transparent 60%);
    opacity: calc(var(--shade, 0) * 0.7);
  }
  .book-mode .face.back::after {
    background: linear-gradient(270deg, rgb(0 0 0 / 0.35), transparent 60%);
  }
  .book-mode .cover {
    min-height: 0;
    border-radius: 6px 16px 16px 6px;
  }
  .book-mode .end-back {
    display: block;
    background: linear-gradient(160deg, #13244a, #0a1222 70%);
  }
  .book-mode .text-page {
    display: flex;
    flex-direction: column;
  }
  .book-mode .prose-book {
    font-size: clamp(0.95rem, 0.6rem + 0.55vh, 1.08rem);
    line-height: 1.66;
    gap: 12px;
  }
  .book-mode .text-page h2 {
    font-size: clamp(1.5rem, 1rem + 1.2vh, 2.1rem);
    margin-bottom: 18px;
  }

  .hud {
    align-items: center;
    gap: 14px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .hud-page {
    color: var(--ink);
    min-width: 11ch;
  }
  .hud-bar {
    width: 160px;
    height: 4px;
    border-radius: 2px;
    background: var(--line-2);
    overflow: hidden;
  }
  .hud-bar i {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--up));
    transition: width 0.3s ease;
  }

  /* ---------- penutup ---------- */
  .end-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: end;
    padding: clamp(28px, 4vw, 48px);
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .end-card > div:first-child {
    display: grid;
    gap: 12px;
  }
  .end-card .btn-row {
    justify-content: flex-end;
  }
  @media (max-width: 860px) {
    .end-card {
      grid-template-columns: 1fr;
    }
    .end-card .btn-row {
      justify-content: stretch;
    }
  }

  /* ---------- halaman kiri ---------- */
  .left-page {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .left-page .dg {
    flex: 0 1 auto;
  }
  .note {
    border-left: 3px solid var(--d-accent);
    background: rgb(37 99 235 / 0.07);
    border-radius: 0 10px 10px 0;
    padding: 14px 16px;
    display: grid;
    gap: 6px;
    color: var(--ink-p);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .note p {
    margin: 0;
  }
  .note.solo {
    margin-block: auto;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-family: var(--font-display);
    font-weight: 600;
    padding: 22px 24px;
  }
  .note-label {
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--d-accent);
  }
  .big-head {
    margin-block: auto;
    font: 700 clamp(1.6rem, 3vw, 2.4rem) / 1.1 var(--font-display);
    color: #c9c0aa;
  }
  .book-mode .left-page .dg {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .book-mode .left-page .dg svg {
    flex: 1 1 0;
    min-height: 0;
    height: 100%;
  }
</style>
